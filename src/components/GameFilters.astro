---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 space-y-6"
    data-testid="game-filters"
    aria-label="Filter games"
>
    <fieldset>
        <legend class="text-sm font-medium text-slate-100 mb-3">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 text-sm text-slate-300 cursor-pointer">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div>
        <label for="filter-publisher" class="block text-sm font-medium text-slate-100 mb-2">Publisher</label>
        <select
            id="filter-publisher"
            name="publisher"
            class="w-full sm:w-64 rounded-lg bg-slate-900 border border-slate-600 text-slate-100 text-sm px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-publisher"
        >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
            ))}
        </select>
    </div>

    <div class="flex items-center gap-4">
        <button
            type="button"
            class="rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 text-sm font-medium px-4 py-2 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-clear"
        >
            Clear filters
        </button>
        <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-count"></p>
    </div>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const emptyMessage = document.querySelector<HTMLElement>('[data-testid="filter-empty"]');
    const count = form?.querySelector<HTMLElement>('[data-testid="filter-count"]');
    const checkboxes = Array.from(form?.querySelectorAll<HTMLInputElement>('input[name="category"]') ?? []);
    const publisherSelect = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const clearButton = form?.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]');

    function readUrl(): void {
        const params = new URLSearchParams(window.location.search);
        const selected = new Set((params.get('category') ?? '').split(',').filter(Boolean));
        checkboxes.forEach((box) => {
            box.checked = selected.has(box.value);
        });
        if (publisherSelect) {
            const publisher = params.get('publisher') ?? '';
            publisherSelect.value = Array.from(publisherSelect.options).some((o) => o.value === publisher)
                ? publisher
                : '';
        }
    }

    function apply(updateUrl: boolean): void {
        const categoryIds = checkboxes.filter((box) => box.checked).map((box) => box.value);
        const publisherId = publisherSelect?.value ?? '';

        let visible = 0;
        cards.forEach((card) => {
            const matchesCategory = categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
            const matchesPublisher = publisherId === '' || card.dataset.publisherId === publisherId;
            const show = matchesCategory && matchesPublisher;
            card.hidden = !show;
            if (show) visible += 1;
        });

        if (emptyMessage) emptyMessage.hidden = visible !== 0;
        if (count) count.textContent = `Showing ${visible} of ${cards.length} games`;

        if (updateUrl) {
            const params = new URLSearchParams();
            if (categoryIds.length > 0) params.set('category', categoryIds.join(','));
            if (publisherId !== '') params.set('publisher', publisherId);
            const query = params.toString();
            history.replaceState(null, '', query ? `?${query}` : window.location.pathname);
        }
    }

    form?.addEventListener('change', () => apply(true));
    form?.addEventListener('submit', (event) => event.preventDefault());
    clearButton?.addEventListener('click', () => {
        checkboxes.forEach((box) => {
            box.checked = false;
        });
        if (publisherSelect) publisherSelect.value = '';
        apply(true);
    });

    readUrl();
    apply(false);
</script>
